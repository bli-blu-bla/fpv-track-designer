FROM node:24-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci --include=optional

COPY . .
# Vite mode selects the .env file: production (.env.production) or development (local PocketBase).
ARG BUILD_MODE=production
RUN npm run build:viewer -- --mode "$BUILD_MODE"

FROM nginx:alpine
COPY --from=build /app/dist-viewer /usr/share/nginx/html
COPY nginx.viewer.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
