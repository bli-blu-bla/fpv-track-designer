FROM node:24-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci --include=optional

COPY . .
RUN npm run build:viewer

FROM nginx:alpine
COPY --from=build /app/dist-viewer /usr/share/nginx/html
COPY nginx.viewer.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
